# Copy to `.env.local` (git-ignored) for local development. Never commit real values to a tracked file.
# Both values are safe to ship in the browser: access to data is enforced by Row Level Security in Supabase.
# Do NOT put the service-role key, database password or Google client secret here.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
